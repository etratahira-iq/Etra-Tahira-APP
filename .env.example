# ===== إعدادات التشغيل =====
# محلياً لا تحتاج أي شيء من هذه المتغيرات — التخزين يكون في مجلد data تلقائياً.

# قاعدة البيانات السحابية (Upstash Redis عبر Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# تخزين الصور — اختر واحداً:
# 1) Vercel Blob
BLOB_READ_WRITE_TOKEN=
# 2) أو Cloudinary (unsigned preset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# حساب المدير الأول (يُنشأ تلقائياً عند أول تشغيل سحابي)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=

# كلمة سر مهمة النسخ الاحتياطي اليومية
CRON_SECRET=
